{
  "name": "task-workbench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:dist": "node scripts/check-dist-clean.mjs",
    "serve": "node scripts/serve.mjs --port 5173",
    "verify": "npm run typecheck && npm test && node --check dist/main.js && npm run check:dist && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.5.0"
  }
}
