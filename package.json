{
  "name": "task-workbench",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && vue-tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "visual:baseline": "npm run build && node scripts/capture-visuals.mjs",
    "typecheck": "vue-tsc --noEmit",
    "check:dist": "node scripts/check-dist-clean.mjs",
    "validate:feedback": "node scripts/validate-feedback.mjs",
    "verify": "npm run validate:feedback && npm run typecheck && npm test && npm run check:dist && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^5.5.0",
    "vite": "^8.2.1",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.2",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.0.0",
    "dompurify": "^3.4.13",
    "jszip": "^3.10.1",
    "lucide": "^1.31.0",
    "marked": "^16.2.1",
    "vue": "^3.5.41"
  }
}
