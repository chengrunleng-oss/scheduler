{
  "name": "task-workbench",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc --noEmit && vite build",
    "dev": "vite",
    "preview": "vite preview",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "check:dist": "node scripts/check-dist-clean.mjs",
    "verify": "npm run typecheck && npm test && npm run check:dist && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.5.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.2",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "^3.0.0",
    "lucide": "^1.31.0"
  }
}
