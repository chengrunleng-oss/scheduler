{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://task-workbench.local/schema/registry.schema.json",
  "title": "scheduler_findings_registry",
  "description": "问题登记表格式契约。登记表是 finding 生命周期与发布门槛的唯一权威。",
  "type": "object",
  "required": ["document_type", "format_version", "updated", "release_gate", "rounds", "findings"],
  "properties": {
    "document_type": { "const": "scheduler_findings_registry" },
    "format_version": { "const": 1 },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "release_gate": {
      "type": "object",
      "required": ["target_release", "status", "exit_criteria"],
      "properties": {
        "target_release": { "type": "string", "minLength": 1 },
        "status": { "enum": ["passed", "blocked", "pending"] },
        "exit_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "finding_ids", "description", "status"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "finding_ids": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string", "minLength": 1 },
              "status": { "enum": ["met", "pending"] },
              "evidence": { "type": "string" }
            }
          }
        }
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["snapshot", "test_date", "format_version", "target_branch", "source_revision", "target_release", "status"],
        "properties": {
          "snapshot": { "type": "string", "minLength": 1 },
          "test_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "format_version": { "type": "integer", "minimum": 1 },
          "target_branch": { "type": "string", "minLength": 1 },
          "source_revision": { "type": "string", "minLength": 1 },
          "target_release": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "partially_conforms", "changes_required", "needs_revision", "passed_with_manual_verification_pending"] },
          "note": { "type": "string" }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "category", "kind", "title", "status", "history"],
        "properties": {
          "id": { "type": "string", "pattern": "^TEST-V\\d{2}-\\d{3}$" },
          "severity": { "enum": ["P0", "P1", "P2"] },
          "category": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["defect", "manual-verification", "process", "enhancement"] },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["open", "fixed", "verified", "closed"] },
          "fix_commit": { "type": ["string", "null"], "minLength": 1 },
          "verified_by": { "type": "array", "items": { "type": "string" } },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "resolution": { "type": ["string", "null"] },
          "history": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["date", "event"],
              "properties": {
                "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
                "event": { "enum": ["opened", "fixed", "verified", "closed", "reopened", "noted"] },
                "round": { "type": "string" },
                "evidence": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
